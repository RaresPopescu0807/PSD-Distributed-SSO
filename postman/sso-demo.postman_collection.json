{
  "info": {
    "name": "SSO Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Single Sign-On demo: log in once at the SSO server, use the same token in three applications, log out everywhere."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "sso_server",
      "value": "http://localhost:8080"
    },
    {
      "key": "catalog",
      "value": "http://localhost:8081"
    },
    {
      "key": "library",
      "value": "http://localhost:8082"
    },
    {
      "key": "forum",
      "value": "http://localhost:8083"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "student_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. SSO login",
      "item": [
        {
          "name": "Call an app without token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalog}}/me",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login as bob (professor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{sso_server}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"bob123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);",
                  "pm.test(\"token saved in {{token}}\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{sso_server}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"wrong\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Public key (JWKS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{sso_server}}/.well-known/jwks.json",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Catalog (app 1)",
      "item": [
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalog}}/me"
          }
        },
        {
          "name": "List grades",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalog}}/grades"
          }
        },
        {
          "name": "Add grade (professor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{catalog}}/grades",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student\": \"alice\",\n  \"course\": \"Security\",\n  \"value\": 10\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Library (app 2)",
      "item": [
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{library}}/me"
          }
        },
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{library}}/books"
          }
        },
        {
          "name": "Borrow book 2",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{library}}/books/2/borrow"
          }
        },
        {
          "name": "Return book 2",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{library}}/books/2/return"
          }
        }
      ]
    },
    {
      "name": "4. Forum (app 3)",
      "item": [
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{forum}}/me"
          }
        },
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{forum}}/posts"
          }
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{forum}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello\",\n  \"body\": \"Posted with the SSO token\"\n}"
            }
          }
        },
        {
          "name": "Delete post 1",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{forum}}/posts/1"
          }
        }
      ]
    },
    {
      "name": "5. Roles (student)",
      "item": [
        {
          "name": "Login as alice (student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{sso_server}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"alice123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"student_token\", pm.response.json().access_token);",
                  "pm.test(\"token saved in {{student_token}}\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alice sees only her grades",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalog}}/grades",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Alice cannot add grades (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{catalog}}/grades",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student\": \"alice\",\n  \"course\": \"X\",\n  \"value\": 10\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Single logout",
      "item": [
        {
          "name": "Logout bob at SSO server",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{sso_server}}/logout"
          }
        },
        {
          "name": "Catalog rejects token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalog}}/me"
          }
        },
        {
          "name": "Library rejects token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{library}}/me"
          }
        },
        {
          "name": "Forum rejects token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{forum}}/me"
          }
        }
      ]
    }
  ]
}